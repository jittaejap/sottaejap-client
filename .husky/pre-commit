repo_root=$(git rev-parse --show-toplevel 2>/dev/null || pwd)

# GUI IDE는 fish/fnm 셸 환경을 물려받지 않을 수 있다. .node-version으로 fnm 경로를 직접 찾는다.
if ! command -v node >/dev/null 2>&1 && [ -f "$repo_root/.node-version" ]; then
  IFS= read -r node_version < "$repo_root/.node-version"
  node_version=${node_version#v}
  fnm_root="${XDG_DATA_HOME:-$HOME/.local/share}/fnm"

  # Windows의 fnm 루트는 %APPDATA%\fnm. FNM_DIR은 셸 훅이 돈 뒤에만 있으므로 APPDATA를 쓴다.
  # cygpath 없이 "C:/..."를 PATH에 넣으면 콜론 때문에 깨진다.
  if [ -n "$APPDATA" ] && command -v cygpath >/dev/null 2>&1; then
    fnm_root="$(cygpath -u "$APPDATA")/fnm"
  fi

  node_install="$fnm_root/node-versions/v${node_version}/installation"

  # Linux/macOS는 installation/bin, Windows는 installation 바로 아래에 node가 있다.
  for fnm_node_bin in "$node_install/bin" "$node_install"; do
    if [ -x "$fnm_node_bin/node" ]; then
      PATH="$fnm_node_bin:$PATH"
      export PATH
      break
    fi
  done
fi

if ! command -v node >/dev/null 2>&1; then
  echo "Node.js를 찾을 수 없습니다. .node-version(24.20.0) 환경을 확인해 주세요."
  exit 1
fi

lint_staged_bin="$repo_root/node_modules/.bin/lint-staged"

if [ ! -x "$lint_staged_bin" ]; then
  echo "lint-staged가 설치되지 않았습니다. 저장소 루트에서 npm install을 실행해 주세요."
  exit 1
fi

"$lint_staged_bin"
