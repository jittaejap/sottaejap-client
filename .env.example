# 클라이언트가 요구하는 환경 변수의 목록과 예시 값이다.
#
#   cp .env.example .env            (macOS)
#   Copy-Item .env.example .env     (Windows PowerShell)
#
# `VITE_` 접두사가 붙은 값은 빌드 산출물에 그대로 박혀 브라우저로 나간다.
# 비밀값, 토큰, 서버 전용 키를 여기에 두지 않는다.

# Spring 서버 주소 (07 §3). 로컬은 sottaejap-server의 :8080.
VITE_API_BASE_URL=http://localhost:8080
